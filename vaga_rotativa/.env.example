# RTSP do DVR Intelbras (protocolo Dahua) - canal e subtipo da camera que
# enxerga a vaga. Exemplo: rtsp://usuario:senha@IP:554/cam/realmonitor?channel=6&subtype=0
RTSP_URL=

# Identificador logico desta vaga (vai para a coluna vaga_id no Supabase) -
# permite monitorar mais de uma vaga no futuro, cada uma com seu proprio
# processo/config, todas gravando na mesma tabela vaga_eventos.
VAGA_ID=vaga_01

# Supabase - mesmo projeto do app de contagem de pessoas/veiculos (so uma
# tabela nova, vaga_eventos). Use a chave "service_role" aqui (nao a anon) -
# e o script Python gravando/atualizando, precisa bypassar a RLS de leitura
# publica (ver sql/001_rls_leitura_publica.sql). Nunca use essa chave no
# dashboard (React) - la e sempre a anon.
SUPABASE_URL=
SUPABASE_KEY=

# Modelo YOLO e device de inferencia (mesmas opcoes do projeto principal).
MODEL_PATH=yolov8s.pt
DEVICE=
HALF_PRECISION=true

# Confianca minima do YOLO para considerar uma deteccao de veiculo valida.
CONF_THRESHOLD=0.35

# Tamanho de imagem usado na inferencia (1280 = resolucao nativa tipica de DVR).
IMGSZ=1280

# Tempo continuo dentro da zona de monitoramento para confirmar que o
# veiculo realmente estacionou (evita contar transito lento/parada de farol).
TEMPO_CONFIRMAR_ESTACIONADO_SEGUNDOS=20

# Tempo sem nenhuma deteccao (nem na zona de monitoramento, verde) para
# considerar que o veiculo realmente saiu - tolera oclusao/flicker passageiro.
TEMPO_TOLERANCIA_SAIDA_SEGUNDOS=20

# Tempo maximo permitido de permanencia (estacionamento rotativo) antes de
# tirar uma foto local e marcar o evento como excedido.
LIMITE_MINUTOS_PERMITIDO=15

# Zona de exclusao (vermelho, opcional) - poligono(s) de 4 pontos a ignorar
# na deteccao. Formato "x1,y1,x2,y2,x3,y3,x4,y4", varios separados por ";".
# Gerado por: python vaga_rotativa/scripts/calibrar_zonas.py --alvo exclusao
ZONA_EXCLUSAO=

# Zona de monitoramento (verde, obrigatoria) - poligono unico de 4 pontos,
# a area da propria vaga. Gerado por:
#   python vaga_rotativa/scripts/calibrar_zonas.py --alvo monitoramento
ZONA_MONITORAMENTO=
