# RTSP da camera Yoosee (senha de RTSP definida em Configuracoes > Seguranca > RTSP)
RTSP_URL=rtsp://admin:SENHA_RTSP@192.168.15.186:554/onvif1

# Identificador logico desta camera (vai para a coluna camera_id no Supabase)
CAMERA_ID=calcada_01

# Supabase (Fase 3+)
SUPABASE_URL=
SUPABASE_KEY=

# Modelo YOLO (nano por padrao; subir para yolov8s.pt/yolov8m.pt se a acuracia nao for suficiente)
MODEL_PATH=yolov8n.pt

# Dispositivo de inferencia: "" = auto, "0" = primeira GPU, "1" = segunda GPU, "cpu" = forcar CPU
DEVICE=

# Confianca minima para considerar uma deteccao de pessoa valida
CONF_THRESHOLD=0.4

# Processar 1 a cada N frames (1 = todo frame, 2 = pula metade, etc.)
FRAME_SKIP=1

# Tamanho da imagem usado na inferencia. Valor maior preserva mais detalhe
# (ajuda a nao fundir 2 veiculos proximos numa unica deteccao classificada
# errado), ao custo de mais processamento. Padrao Ultralytics: 640.
IMGSZ=640

# Linha de contagem de pessoas (coordenadas em pixels), gerada por:
#   python scripts/calibrar_linha.py
LINE_X1=
LINE_Y1=
LINE_X2=
LINE_Y2=

# Linha de contagem de veiculos (opcional - deixe vazio para contar so pessoas).
# Gerada por:
#   python scripts/calibrar_linha.py --alvo veiculos
LINE_VEICULOS_X1=
LINE_VEICULOS_Y1=
LINE_VEICULOS_X2=
LINE_VEICULOS_Y2=
