# RTSP da camera Yoosee (senha de RTSP definida em Configuracoes > Seguranca > RTSP)
RTSP_URL=rtsp://admin:SENHA_RTSP@192.168.15.186:554/onvif1

# Identificador logico desta camera (vai para a coluna camera_id no Supabase)
CAMERA_ID=calcada_01

# Supabase (Fase 3+)
SUPABASE_URL=
SUPABASE_KEY=

# Modelo YOLO (nano por padrao; subir para yolov8s.pt/yolov8m.pt se a acuracia nao for suficiente)
MODEL_PATH=yolov8n.pt

# Dispositivo de inferencia: "" = auto, "0" = primeira GPU, "1" = segunda GPU, "cpu" = forcar CPU
DEVICE=

# Precisao FP16 (half) na inferencia - quase 2x mais rapido em GPU CUDA,
# sem perda perceptivel de acuracia. So tem efeito com GPU de verdade
# (desligado automaticamente em CPU, mesmo com true aqui).
HALF_PRECISION=false

# Test-time augmentation: roda a inferencia em multiplas escalas/
# espelhamentos e combina os resultados. Ajuda a recuperar veiculos com
# motion blur ou parcialmente visiveis, ao custo de ~2-3x mais
# processamento por frame - so vale a pena com GPU sobrando.
AUGMENT_INFERENCE=false

# Confianca minima para considerar uma deteccao de pessoa valida
CONF_THRESHOLD=0.4

# Processar 1 a cada N frames (1 = todo frame, 2 = pula metade, etc.)
FRAME_SKIP=1

# Tamanho da imagem usado na inferencia. Valor maior preserva mais detalhe
# (ajuda a nao fundir 2 veiculos proximos numa unica deteccao classificada
# errado), ao custo de mais processamento. Padrao Ultralytics: 640.
IMGSZ=640

# Modo noite: detecta automaticamente pela saturacao de cor do frame (~0
# em modo infravermelho P&B - o brilho medio sozinho engana, pois o IV
# ilumina a cena) e, quando ativo, realca contraste (CLAHE) + usa um
# limiar de confianca mais baixo, ja que farois acesos estouram o brilho e
# escondem a carroceria do veiculo.
ENABLE_NIGHT_MODE=true
NIGHT_SATURATION_THRESHOLD=20
NIGHT_LUMINANCE_THRESHOLD=70
NIGHT_CONF_THRESHOLD=0.25
NIGHT_CLAHE_CLIP_LIMIT=2.5

# Config do tracker ByteTrack (opcional - por padrao usa
# trackers/bytetrack_tolerante.yaml, mais tolerante a deteccao intermitente).
TRACKER_CONFIG=

# Contagem de veiculos (dia e noite) por ZONA + cooldown, em vez de exigir
# o cruzamento completo da linha (que falha sempre que o tracking
# fragmenta - por deteccao intermitente, motion blur ou oclusao parcial).
# So conta deteccoes com confianca suficiente dentro de uma faixa ao redor
# da linha. Deteccoes do mesmo tipo perto (posicao) e logo em seguida
# (tempo) sao tratadas como o mesmo veiculo, evitando contar 2x quando o
# track_id muda no meio da passagem.
NIGHT_ZONE_MIN_CONF=0.55
NIGHT_ZONE_WIDTH_PX=220
NIGHT_ZONE_COOLDOWN_SECONDS=5.0
NIGHT_ZONE_DEDUPE_DISTANCE_PX=200

DAY_ZONE_MIN_CONF=0.35
DAY_ZONE_WIDTH_PX=150
DAY_ZONE_COOLDOWN_SECONDS=5.0
DAY_ZONE_DEDUPE_DISTANCE_PX=200

# Linha de contagem de pessoas (coordenadas em pixels), gerada por:
#   python scripts/calibrar_linha.py
LINE_X1=
LINE_Y1=
LINE_X2=
LINE_Y2=

# Linha de contagem de veiculos (opcional - deixe vazio para contar so pessoas).
# Gerada por:
#   python scripts/calibrar_linha.py --alvo veiculos
LINE_VEICULOS_X1=
LINE_VEICULOS_Y1=
LINE_VEICULOS_X2=
LINE_VEICULOS_Y2=

# Linha de veiculos para a zona noturna (opcional - se vazia, usa a mesma
# linha de cima). Vale calibrar separada porque a noite o veiculo costuma
# ser detectado com mais confianca assim que entra no quadro. Gerada por
# (rode de noite, com IR ativo):
#   python scripts/calibrar_linha.py --alvo veiculos-noite
LINE_VEICULOS_NOITE_X1=
LINE_VEICULOS_NOITE_Y1=
LINE_VEICULOS_NOITE_X2=
LINE_VEICULOS_NOITE_Y2=
