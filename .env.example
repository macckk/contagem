# RTSP da camera Yoosee (senha de RTSP definida em Configuracoes > Seguranca > RTSP)
RTSP_URL=rtsp://admin:SENHA_RTSP@192.168.15.186:554/onvif1

# Identificador logico desta camera (vai para a coluna camera_id no Supabase)
CAMERA_ID=calcada_01

# Supabase (Fase 3+)
SUPABASE_URL=
SUPABASE_KEY=

# Modelo YOLO (nano por padrao; subir para yolov8s.pt/yolov8m.pt se a acuracia nao for suficiente)
MODEL_PATH=yolov8n.pt

# Dispositivo de inferencia: "" = auto, "0" = primeira GPU, "1" = segunda GPU, "cpu" = forcar CPU
DEVICE=

# Confianca minima para considerar uma deteccao de pessoa valida
CONF_THRESHOLD=0.4

# Processar 1 a cada N frames (1 = todo frame, 2 = pula metade, etc.)
FRAME_SKIP=1

# Linha de contagem (coordenadas em pixels no frame 1280x720), gerada pelo scripts/calibrar_linha.py
LINE_X1=
LINE_Y1=
LINE_X2=
LINE_Y2=
